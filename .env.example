# ============================================================
# AsistenteInteligente — variables de entorno (EJEMPLO)
# Copiar a .env.local para desarrollo local:
#   Copy-Item .env.example .env.local
# NO poner secretos reales en este archivo.
# ============================================================

# ---- MODO DEMO (por defecto) ----
# La app funciona sin base de datos ni API keys de IA.
# Contrato en src/lib/demo.ts: todo valor distinto de 'false' = demo.
NEXT_PUBLIC_DEMO_MODE=true

# ---- MODO REAL ----
# Para modo real: NEXT_PUBLIC_DEMO_MODE=false + completar lo de abajo.
# NEXT_PUBLIC_DEMO_MODE=false

# Base de datos Postgres (requerida por setup-database-pg, add-admin,
# hash-passwords y clean-sessions; sin ella esos scripts se omiten con
# aviso "modo demo: omitido" y exit 0).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Supabase (requerido por setup-database).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Secreto para firmar JWT (ver src/lib/auth.ts y src/lib/admin-auth.ts).
# Generar uno propio de al menos 32 caracteres. Ejemplo de generación:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UNO_PROPIO_DE_AL_MENOS_32_CARACTERES

# API keys de IA (modo real). El chat usa OPENROUTER_API_KEY
# (ver src/app/api/chat/route.ts y src/ai/openrouter.ts).
GOOGLE_API_KEY=TU_GOOGLE_API_KEY_AQUI
OPENROUTER_API_KEY=TU_OPENROUTER_API_KEY_AQUI
